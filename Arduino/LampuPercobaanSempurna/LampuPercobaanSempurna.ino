void setup() {
  pinMode(LED_BUILTIN, OUTPUT);  // Set LED internal sebagai output
}

void loop() {
digitalWrite(LED_BUILTIN, LOW);   // Nyalakan LED (LOW karena LED internal aktif-low)
  delay(10);                      // Tunggu 1 detik
  digitalWrite(LED_BUILTIN, HIGH);  // Matikan LED
  delay(2000);                      // Tunggu 1 detik}
digitalWrite(LED_BUILTIN, LOW);   // Nyalakan LED (LOW karena LED internal aktif-low)
  delay(20);                      // Tunggu 1 detik
  digitalWrite(LED_BUILTIN, HIGH);  // Matikan LED
  delay(800);                      // Tunggu 1 detik
digitalWrite(LED_BUILTIN, LOW);   // Nyalakan LED (LOW karena LED internal aktif-low)
  delay(200);                      // Tunggu 1 detik
  digitalWrite(LED_BUILTIN, HIGH);  // Matikan LED
  delay(100);                      // Tunggu 1 detik}
digitalWrite(LED_BUILTIN, LOW);   // Nyalakan LED (LOW karena LED internal aktif-low)
  delay(10);                      // Tunggu 1 detik
  digitalWrite(LED_BUILTIN, HIGH);  // Matikan LED
  delay(2000);                      // Tunggu 1 detik}
  }

